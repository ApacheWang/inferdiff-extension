{
  "manifest_version": 3,
  "name": "inferdiff Relay Radar",
  "version": "0.1.0",
  "description": "Verify OpenAI-compatible streaming APIs and relays and export a wire health scorecard.",
  "action": {
    "default_title": "inferdiff Relay Radar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
